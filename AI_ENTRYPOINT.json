{
  "project": "CyberAtlas",
  "project_version": "0.1.0",
  "release_stage": "research_preview",
  "roadmap": "ROADMAP.md",
  "mode": "machine_first_no_visual_interface",
  "schema_version": "1.0",
  "node_title_language": "en",
  "description_language": "vi",
  "preserved_search_aliases": "Previous Vietnamese titles",
  "instructions": "AGENTS.md",
  "canonical_pointer": "graph/CURRENT",
  "revision_directory_pattern": "graph/revisions/<CURRENT>/",
  "read_first_in_revision": ["manifest.json", "index.json"],
  "canonical_records": ["nodes/<id>.json", "edges.jsonl", "metrics.json", "sources.json", "observations.json"],
  "derived_projections": ["io_map.json", "mechanisms.json", "evidence.json"],
  "cli": "graph.py",
  "selective_load": "python graph.py get <node-id> --max-chars 22000",
  "update": "python graph.py apply <patch.json> --dry-run; then apply after valid result",
  "validation": ["python graph.py validate", "python test_graph.py", "python synthetic_examples.py"],
  "portable_snapshot": "exports/cybersecurity.nodes.jsonl",
  "frame": "Educational authored mechanism map; organization observations must be supplied and scoped separately.",
  "method": "Metric Generation: decompose meaning/domain/mechanism/conditions before generating measures.",
  "source_book": "urn:cyber-atlas:source:book",
  "source_method": "urn:cyber-atlas:source:metric",
  "seed_only": ["data/atlas.json", "ATLAS.md", "vault/", "content.py", "refinements.py", "deepdives.py", "build.py"],
  "do_not": ["overwrite CURRENT from the initial seed", "silently drop missing data", "promote a synthetic test to a real observation", "launch a visualization without a new user request"]
}
